# Supabase -> Project Settings -> Database -> Connection string (URI, session pooler)
DATABASE_URL=postgresql://postgres.xxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Supabase project URL (used to fetch the JWKS that signs user tokens)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only needed for legacy HS256 projects: Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
