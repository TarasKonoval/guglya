# From Terraform outputs / SSM:  cd infra/terraform && terraform output
#   DATABASE_URL: aws ssm get-parameter --name /guglya/database_url --with-decryption --query Parameter.Value --output text
DATABASE_URL=postgresql://guglya_admin:PASSWORD@guglya-db.xxxx.eu-central-1.rds.amazonaws.com:5432/guglya?sslmode=require
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Leave empty locally: fetched from Cognito at startup. Lambda gets it from Terraform.
COGNITO_JWKS=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
