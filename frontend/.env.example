# Values come from `terraform -chdir=infra/terraform output` (deploy-frontend.sh writes .env.production itself)
VITE_AWS_REGION=eu-central-1
VITE_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_URL=http://localhost:8000
# Google sign-in via Cognito hosted domain (terraform output cognito_domain / google_enabled)
VITE_COGNITO_DOMAIN=guglya-auth.auth.eu-central-1.amazoncognito.com
VITE_GOOGLE_ENABLED=false
VITE_DONATE_URL=
# Local dev only: catalog images are served by the live site under /img/
VITE_ASSET_BASE_URL=https://guglya.studio
